---
import '@fontsource-variable/nunito-sans';
import '../styles/global.css';
// The one subset every page actually needs: Catalan, Spanish and English all
// live inside `latin`. Imported as a URL so the preload below points at the
// same hashed asset the stylesheet requests, instead of a second copy.
import nunitoSansLatin from '@fontsource-variable/nunito-sans/files/nunito-sans-latin-wght-normal.woff2?url';
import BrandMark from '../components/BrandMark.astro';
import IconSprite from '../components/IconSprite.astro';
import { createTranslator } from '../lib/i18n.ts';
import { manifestPath } from '../lib/manifest.ts';
import { signLanguageOf } from '../lib/types.ts';
import {
  DEFAULT_LOCALE,
  LOCALE_NAMES,
  ROUTED_LOCALES,
  localeHref,
  type RoutedLocale,
} from '../lib/routing.ts';
import { ANALYTICS_ENDPOINT, REPO_URL, analyticsHost } from '../lib/site.ts';
// The counter is served from this site, not GoatCounter's CDN: see the comment on the script below.
import counterScript from '../vendor/goatcounter/count.js?url';
import {
  APPLE_TOUCH_ICON,
  OG_IMAGES,
  OG_IMAGE_HEIGHT,
  OG_IMAGE_WIDTH,
  OG_LOCALES,
  breadcrumbJsonLd,
  documentTitle,
  serializeJsonLd,
  websiteJsonLd,
  type Crumb,
  type JsonLd,
} from '../lib/seo.ts';

interface Props {
  /** The routed interface language of this page. */
  language: RoutedLocale;
  /** Locale-independent path of this page, always `/…/` (e.g. `/`, `/credits/`). */
  path: string;
  /**
   * What this page is about, in the words someone would search for. The site's
   * name is appended when there is room for it (see `documentTitle`).
   */
  title?: string;
  description?: string;
  /**
   * Keep this page out of search results and out of the language graph. Only
   * the 404 needs it: it answers on every wrong URL, so a canonical link would
   * claim thousands of addresses are the same page.
   */
  noindex?: boolean;
  /**
   * The trail the page's visible breadcrumb shows, so the same list reaches
   * search engines as a `BreadcrumbList`. Pass the array `<Breadcrumb>` renders.
   */
  breadcrumb?: readonly Crumb[];
}

const { language, path, title, description, noindex = false, breadcrumb } = Astro.props;
const t = createTranslator(language);

// The sign language is derived here, at build time, and baked into the markup.
// Nothing on the client changes it, so there is no hydration mismatch.
const signLanguage = signLanguageOf(language);

const pageTitle = documentTitle(title, t('site.title'));
const pageDescription = description ?? t('site.tagline');

const homeHref = localeHref('/', language);
const aboutHref = localeHref('/el-projecte/', language);
const creditsHref = localeHref('/credits/', language);
const accessibilityHref = localeHref('/accessibilitat/', language);
const canonical = new URL(localeHref(path, language), Astro.site);

// Keyed on `noindex` for the same reason the canonical link is: the 404 also
// renders at `/`, and a page kept out of the index has nothing to declare.
// Built against `Astro.site`, like the canonical, so a preview describes
// itself rather than production.
const origin = String(Astro.site);
const structuredData: JsonLd[] = noindex
  ? []
  : [
      ...(path === '/' ? [websiteJsonLd(t('site.title'), homeHref, language, origin)] : []),
      ...(breadcrumb ? [breadcrumbJsonLd(breadcrumb, origin)] : []),
    ];

/** `aria-current="page"` on the header link for the page being viewed. */
const isCurrent = (target: string): 'page' | undefined => (path === target ? 'page' : undefined);
---

<!doctype html>
<html lang={language} data-sign-language={signLanguage}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="color-scheme" content="light dark" />
    {
      /*
      Without this the browser paints in the system font, the web font arrives
      and every line of text reflows: a 0.167 layout shift on the text-only
      pages, which is a visible jump for the reader and the one metric that
      failed the performance budget. Preloading gets the font in before first
      paint, so `font-display: swap` has nothing left to swap.

      `crossorigin` is not optional: fonts are fetched in CORS mode even from
      our own origin, and without it the preload is simply ignored and the file
      downloaded a second time.
    */
    }
    <link rel="preload" href={nunitoSansLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {
      /*
      iOS ignores the manifest and reads this instead, so "add to home screen"
      needs a PNG: an SVG favicon alone leaves a generic screenshot on the
      home screen of the one device this site is designed for.
    */
    }
    <link rel="apple-touch-icon" href={APPLE_TOUCH_ICON} />
    <link rel="manifest" href={manifestPath(language)} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {/* Tell search engines about the other language versions of this page. */}
    {
      !noindex &&
        ROUTED_LOCALES.map((locale) => (
          <link
            rel="alternate"
            hreflang={locale}
            href={new URL(localeHref(path, locale), Astro.site)}
          />
        ))
    }
    {
      !noindex && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(localeHref(path, DEFAULT_LOCALE), Astro.site)}
        />
      )
    }
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={OG_LOCALES[language]} />
    {
      /* The same page in the other language, as `hreflang` says it for crawlers. */
      !noindex &&
        ROUTED_LOCALES.filter((locale) => locale !== language).map((locale) => (
          <meta property="og:locale:alternate" content={OG_LOCALES[locale]} />
        ))
    }
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={t('site.title')} />
    {
      /*
      Absolute, because a share sheet fetches this from its own servers and has
      no page to resolve a relative path against. Declaring the dimensions lets
      the card reserve its space before the image arrives instead of reflowing
      the preview.
    */
    }
    <meta property="og:image" content={new URL(OG_IMAGES[language], Astro.site)} />
    <meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />
    <meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />
    <meta property="og:image:alt" content={pageDescription} />
    <meta name="twitter:card" content="summary_large_image" />
    {
      /*
      Data, not code: the browser never runs these, which is why the CSP build
      step leaves them unhashed (see `collectInlineHashes`).
    */
    }
    {
      structuredData.map((data) => (
        <script is:inline type="application/ld+json" set:html={serializeJsonLd(data)} />
      ))
    }

    {
      /*
      Anonymous, cookieless hit counting (see src/lib/analytics.ts).

      Loaded from a script rather than a plain <script> tag because the same
      build is served from production and from every branch preview: without
      the host check, my own testing on `develop.…pages.dev` would be counted
      as real usage. Localhost needs no guard — GoatCounter ignores local
      addresses on its own.

      `is:inline` keeps this out of the bundle: it must run as-is, before any
      island hydrates.

      The counter itself is GoatCounter's `count.js`, copied into
      `src/vendor/goatcounter/` byte for byte and served from this origin.
      Loaded from their CDN it could change under the site without review;
      pinned with SRI to one of their versioned files it would send more than
      today (those send the screen's height and pixel density too). A copy
      under review is both fixed and the leanest. GoatCounter documents this
      and keeps the `/count` endpoint compatible with every copy.
      `src/lib/analytics.test.ts` holds the copy to what the privacy text says.
    */
    }
    <script
      is:inline
      define:vars={{ host: analyticsHost(), endpoint: ANALYTICS_ENDPOINT, src: counterScript }}
    >
      if (location.hostname === host) {
        const script = document.createElement('script');
        script.async = true;
        script.src = src;
        script.dataset.goatcounter = endpoint;
        document.head.appendChild(script);
      }
    </script>
  </head>

  <body class="min-h-dvh">
    <IconSprite />
    <a class="skip-link" href="#main">{t('nav.skipToContent')}</a>

    <header class="app-header glass" id="app-header">
      {
        /*
        `app-header__row` wraps rather than overflows. At 320px — the width
        WCAG 1.4.10 asks the page to survive — the wordmark and the language
        selector together needed 315px of a 288px budget, so the document
        scrolled sideways. The tightened spacing below `sm` is what makes them
        fit; the wrap is what guarantees they always will, whatever a future
        translation does to the string lengths.
      */
      }
      <div class="app-header__row shell flex items-center gap-3 py-3">
        <a href={homeHref} class="brand-mark shrink-0 text-base sm:text-lg">
          <span class="brand-mark__dot" aria-hidden="true">
            <BrandMark class="icon-sm" />
          </span>
          {t('site.title')}
        </a>

        {
          /*
          The language selector doubles as the sign-language selector: each
          locale is coupled to one (ca → LSC, es → LSE). It is a plain set of
          links, so it works without JavaScript and its active state is
          server-rendered — no hydration, no flash of the wrong choice.

          It sits next to the wordmark rather than at the far end because of
          what it actually decides: not a translation of the interface but
          which sign language the whole catalogue teaches. It is also what lets
          the source order below be the same order the eye reads at every
          width — see `.site-nav`.
        */
        }
        <nav class="lang-switch shrink-0" aria-label={t('nav.language')}>
          {
            ROUTED_LOCALES.map((locale) => {
              const active = locale === language;
              const localeSign = signLanguageOf(locale);
              return (
                <a
                  href={localeHref(path, locale)}
                  hreflang={locale}
                  aria-current={active ? 'true' : undefined}
                  class="lang-switch__option"
                >
                  <span class="lang-switch__name">{LOCALE_NAMES[locale]}</span>
                  <span class="lang-switch__sign">
                    {t(localeSign === 'lsc' ? 'signLanguage.lsc' : 'signLanguage.lse')}
                  </span>
                </a>
              );
            })
          }
        </nav>

        {
          /*
          The rest of the site used to live only in the footer: 650 Tab presses
          and 38.6 screens of scroll past the catalogue, with the accessibility
          statement the EAA obliges us to publish at the far end of it.

          Last in source, and last to the eye at every width: from `sm` up it
          is pushed to the far end of the one header row, and below `sm` it
          wraps onto a row of its own under the wordmark. That is why the
          language selector moved up rather than these moving down — any
          arrangement where one of the two crosses the other on one breakpoint
          only makes the tab order disagree with the reading order somewhere.

          On phones the row folds away with the filters while the catalogue is
          being scrolled, so it is present on arrival and on the way back up
          without holding 44px of a sticky header for the whole visit. The
          wrapper exists only to give that fold something to animate; on wider
          screens it is `display: contents` and no box at all.
        */
        }
        <div class="site-nav-fold">
          <nav class="site-nav" aria-label={t('nav.site')}>
            <a class="site-nav__link" href={aboutHref} aria-current={isCurrent('/el-projecte/')}>
              {t('nav.about')}
            </a>
            <a class="site-nav__link" href={creditsHref} aria-current={isCurrent('/credits/')}>
              {t('nav.credits')}
            </a>
            <a
              class="site-nav__link"
              href={accessibilityHref}
              aria-current={isCurrent('/accessibilitat/')}
            >
              {t('nav.accessibility')}
            </a>
          </nav>
        </div>
      </div>

      <slot name="toolbar" />
    </header>

    <main id="main" class="shell py-6">
      <slot />
    </main>

    <footer class="border-border text-ink-muted mt-6 border-t">
      <div class="shell flex flex-col gap-3 py-10 text-sm">
        {
          /*
          `.footer-link` rather than the same four utility classes written out
          four times, and it carries the 44px target the design system promises
          for every control. These were 22px tall — under the 24px floor of
          WCAG 2.5.8 and the only controls on the site breaking our own rule.
        */
        }
        <nav class="footer-nav" id="footer-nav" tabindex="-1" aria-label={t('nav.footer')}>
          <a class="footer-link" href={aboutHref}>{t('nav.about')}</a>
          <a class="footer-link" href={creditsHref}>{t('nav.credits')}</a>
          <a class="footer-link" href={accessibilityHref}>{t('nav.accessibility')}</a>
          <a class="footer-link" href={REPO_URL} target="_blank" rel="noreferrer noopener">
            {t('nav.sourceCode')}
          </a>
        </nav>
      </div>
    </footer>

    <script>
      const header = document.getElementById('app-header');

      if (header) {
        // How far past the header the page must be before its filter rows are
        // worth folding away, and how far the scroll has to reverse before
        // they come back. Without that second number the rows flicker on the
        // small jitter a finger leaves at the end of a swipe.
        const CONDENSE_AFTER = 160;
        const DIRECTION_THRESHOLD = 12;

        // Folding the rows makes the header shorter, which shifts the document
        // and fires another scroll event — one whose direction is the opposite
        // of the gesture that caused it. Left alone that reads as "scrolling
        // up", unfolds the rows, shifts the document back, and the header
        // oscillates. Ignoring direction while the fold animates breaks the
        // loop; the state itself still updates immediately.
        const SETTLE_MS = 320;

        let lastY = window.scrollY;
        let condensed = false;
        let ticking = false;
        // Negative infinity, not 0: `performance.now()` is measured from page
        // load, so starting at 0 would swallow any scroll in the first 320ms
        // as though the header had just folded.
        let settledAt = Number.NEGATIVE_INFINITY;

        // Stated from the start rather than appearing on the first fold, so the
        // header always advertises which of the two states it is in.
        header.dataset.condensed = 'false';

        const update = () => {
          ticking = false;
          const y = window.scrollY;

          // Read once per frame and write once: the shadow and the condensed
          // state share this handler so scrolling never triggers two layouts.
          header.dataset.scrolled = String(y > 4);

          const delta = y - lastY;
          if (Math.abs(delta) < DIRECTION_THRESHOLD) return;
          lastY = y;

          if (performance.now() - settledAt < SETTLE_MS) return;

          const next = delta > 0 && y > CONDENSE_AFTER;
          if (next !== condensed) {
            condensed = next;
            settledAt = performance.now();
            header.dataset.condensed = String(next);
          }
        };

        update();
        window.addEventListener(
          'scroll',
          () => {
            if (ticking) return;
            ticking = true;
            requestAnimationFrame(update);
          },
          { passive: true },
        );
      }
    </script>
  </body>
</html>
