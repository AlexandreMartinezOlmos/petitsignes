---
import '@fontsource-variable/nunito-sans';
import '../styles/global.css';
// The one subset every page actually needs: Catalan, Spanish and English all
// live inside `latin`. Imported as a URL so the preload below points at the
// same hashed asset the stylesheet requests, instead of a second copy.
import nunitoSansLatin from '@fontsource-variable/nunito-sans/files/nunito-sans-latin-wght-normal.woff2?url';
import IconSprite from '../components/IconSprite.astro';
import { createTranslator } from '../lib/i18n.ts';
import { signLanguageOf } from '../lib/types.ts';
import {
  DEFAULT_LOCALE,
  LOCALE_NAMES,
  ROUTED_LOCALES,
  localeHref,
  type RoutedLocale,
} from '../lib/routing.ts';
import { ANALYTICS_ENDPOINT, ANALYTICS_SCRIPT, REPO_URL, analyticsHost } from '../lib/site.ts';

interface Props {
  /** The routed interface language of this page. */
  language: RoutedLocale;
  /** Locale-independent path of this page, always `/…/` (e.g. `/`, `/credits/`). */
  path: string;
  title?: string;
  description?: string;
}

const { language, path, title, description } = Astro.props;
const t = createTranslator(language);

// The sign language is derived here, at build time, and baked into the markup.
// Nothing on the client changes it, so there is no hydration mismatch.
const signLanguage = signLanguageOf(language);

const pageTitle = title ? `${title} · ${t('site.title')}` : t('site.title');
const pageDescription = description ?? t('site.tagline');

const homeHref = localeHref('/', language);
const aboutHref = localeHref('/el-projecte/', language);
const creditsHref = localeHref('/credits/', language);
const accessibilityHref = localeHref('/accessibilitat/', language);
const canonical = new URL(localeHref(path, language), Astro.site);
---

<!doctype html>
<html lang={language} data-sign-language={signLanguage}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="color-scheme" content="light dark" />
    {
      /*
      Without this the browser paints in the system font, the web font arrives
      and every line of text reflows: a 0.167 layout shift on the text-only
      pages, which is a visible jump for the reader and the one metric that
      failed the performance budget. Preloading gets the font in before first
      paint, so `font-display: swap` has nothing left to swap.

      `crossorigin` is not optional: fonts are fetched in CORS mode even from
      our own origin, and without it the preload is simply ignored and the file
      downloaded a second time.
    */
    }
    <link rel="preload" href={nunitoSansLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    {/* Tell search engines about the other language versions of this page. */}
    {
      ROUTED_LOCALES.map((locale) => (
        <link
          rel="alternate"
          hreflang={locale}
          href={new URL(localeHref(path, locale), Astro.site)}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(localeHref(path, DEFAULT_LOCALE), Astro.site)}
    />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={language} />

    {
      /*
      Anonymous, cookieless hit counting (see src/lib/analytics.ts).

      Loaded from a script rather than a plain <script> tag because the same
      build is served from production and from every branch preview: without
      the host check, my own testing on `develop.…pages.dev` would be counted
      as real usage. Localhost needs no guard — GoatCounter ignores local
      addresses on its own.

      `is:inline` keeps this out of the bundle: it must run as-is, before any
      island hydrates.
    */
    }
    <script
      is:inline
      define:vars={{ host: analyticsHost(), endpoint: ANALYTICS_ENDPOINT, src: ANALYTICS_SCRIPT }}
    >
      if (location.hostname === host) {
        const script = document.createElement('script');
        script.async = true;
        script.src = src;
        script.dataset.goatcounter = endpoint;
        document.head.appendChild(script);
      }
    </script>
  </head>

  <body class="min-h-dvh">
    <IconSprite />
    <a class="skip-link" href="#main">{t('nav.skipToContent')}</a>

    <header class="app-header" id="app-header">
      <div class="mx-auto flex max-w-6xl items-center gap-3 px-4 py-3">
        <a href={homeHref} class="brand-mark shrink-0 text-base sm:text-lg">
          <span class="brand-mark__dot" aria-hidden="true">
            <svg class="icon-sm" aria-hidden="true" focusable="false">
              <use href="#i-wave"></use>
            </svg>
          </span>
          {t('site.title')}
        </a>

        {
          /*
          The language selector doubles as the sign-language selector: each
          locale is coupled to one (ca → LSC, es → LSE). It is a plain set of
          links, so it works without JavaScript and its active state is
          server-rendered — no hydration, no flash of the wrong choice.
        */
        }
        <nav class="lang-switch ms-auto shrink-0" aria-label={t('nav.language')}>
          {
            ROUTED_LOCALES.map((locale) => {
              const active = locale === language;
              const localeSign = signLanguageOf(locale);
              return (
                <a
                  href={localeHref(path, locale)}
                  hreflang={locale}
                  aria-current={active ? 'true' : undefined}
                  class="lang-switch__option"
                >
                  <span class="lang-switch__name">{LOCALE_NAMES[locale]}</span>
                  <span class="lang-switch__sign">
                    {t(localeSign === 'lsc' ? 'signLanguage.lsc' : 'signLanguage.lse')}
                  </span>
                </a>
              );
            })
          }
        </nav>
      </div>

      <slot name="toolbar" />
    </header>

    <main id="main" class="mx-auto max-w-6xl px-4 py-6">
      <slot />
    </main>

    <footer class="border-border text-ink-muted mt-16 border-t">
      <div class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-10 text-sm">
        <nav class="flex flex-wrap gap-x-5 gap-y-2" aria-label={t('nav.footer')}>
          <a class="hover:text-ink underline underline-offset-4" href={aboutHref}>
            {t('nav.about')}
          </a>
          <a class="hover:text-ink underline underline-offset-4" href={creditsHref}>
            {t('nav.credits')}
          </a>
          <a class="hover:text-ink underline underline-offset-4" href={accessibilityHref}>
            {t('nav.accessibility')}
          </a>
          <a
            class="hover:text-ink underline underline-offset-4"
            href={REPO_URL}
            target="_blank"
            rel="noreferrer noopener"
          >
            {t('nav.sourceCode')}
          </a>
        </nav>
      </div>
    </footer>

    <script>
      // Give the sticky header a shadow only once content sits behind it.
      const header = document.getElementById('app-header');
      if (header) {
        const onScroll = () => {
          header.dataset.scrolled = String(window.scrollY > 4);
        };
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });
      }
    </script>
  </body>
</html>
