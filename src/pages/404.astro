---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SignCard from '../components/SignCard.astro';
import SignVideoDialog from '../islands/SignVideoDialog.tsx';
import { createTranslator } from '../lib/i18n.ts';
import { DEFAULT_LOCALE, ROUTED_LOCALES, LOCALE_NAMES, localeHref } from '../lib/routing.ts';
import { type Category, type SignEntry } from '../lib/types.ts';

/**
 * The one page served from any address that does not exist.
 *
 * Cloudflare Pages answers every unmatched request with the `404.html` at the
 * root of the output, so there is exactly one of these — it cannot be built per
 * locale. It is therefore written in the default locale and offers both
 * catalogues, rather than guessing from the path and rendering two versions:
 * guessing would mean shipping both sign languages to the same document, which
 * §4.4 rules out precisely so the wrong gesture can never be one style
 * override away from view.
 *
 * The sign it shows is `no` — a real entry with its verified LSC video, not an
 * illustration made for this page. A dead end is the one place where being
 * handed a word costs nothing.
 */
const language = DEFAULT_LOCALE;
const t = createTranslator(language);

const signEntries = await getCollection('signs');
const entry = signEntries.find((item) => item.id === 'no');
if (!entry) {
  throw new Error('404 page expects the sign `no` to exist in the catalogue');
}
const sign: SignEntry = { id: entry.id, ...entry.data } as SignEntry;

const categoryEntries = await getCollection('categories');
const categoryEntry = categoryEntries.find((item) => item.id === sign.category);
if (!categoryEntry) {
  throw new Error(`404 page: category "${sign.category}" is missing`);
}
const category = categoryEntry.data as Category;
---

<BaseLayout language={language} path="/" title={t('notFound.title')} noindex>
  <section class="not-found">
    <p class="not-found__code" aria-hidden="true">404</p>
    <h1 class="not-found__title">{t('notFound.title')}</h1>
    <p class="not-found__lead">{t('notFound.lead')}</p>

    <div class="not-found__card">
      <SignCard sign={sign} category={category} language={language} showCategory={false} />
    </div>

    {
      /*
      Both catalogues, not just this page's own: the visitor may well have been
      heading for the Spanish side when the address failed, and this page cannot
      know which. The default locale leads because it is what `/` serves.
    */
    }
    <nav class="not-found__routes" aria-label={t('notFound.back')}>
      {
        ROUTED_LOCALES.map((locale) => (
          <a
            class:list={[
              'not-found__route',
              locale !== DEFAULT_LOCALE && 'not-found__route--quiet',
            ]}
            href={localeHref('/', locale)}
            hreflang={locale}
          >
            {t('notFound.back')}
            <span class="not-found__locale">{` · ${LOCALE_NAMES[locale]}`}</span>
          </a>
        ))
      }
    </nav>
  </section>

  <SignVideoDialog language={language} client:idle />
</BaseLayout>

<script>
  import { dispatchPlayRequest } from '../lib/catalogue-grid.ts';

  /**
   * The card's play button is wired by the grid controller on the catalogue,
   * and there is no grid here. Rather than ship that whole module for one
   * button, this reuses only the part that turns a click into the request the
   * dialog already listens for — a button that silently did nothing would be a
   * worse dead end than the one the visitor arrived at.
   */
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const button = target.closest<HTMLButtonElement>('button[data-action="play"]');
    const signId = button?.dataset.signId;
    if (button && signId) dispatchPlayRequest(button, signId);
  });
</script>

<style>
  /* Only this page uses these, so they stay here rather than in global.css —
     the design system is for what repeats. */
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding-block: 2rem 3rem;
    text-align: center;
  }

  .not-found__code {
    font-size: var(--text-display);
    font-weight: var(--font-weight-display);
    line-height: 1;
    color: var(--color-brand-soft);
    /* Decorative, and large enough to shout: it is announced to nobody
       (aria-hidden) because the heading below already says it in words. */
  }

  .not-found__title {
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-display);
    line-height: var(--text-display--line-height);
    letter-spacing: var(--text-display--letter-spacing);
    color: var(--color-ink);
  }

  .not-found__lead {
    max-inline-size: 46ch;
    font-size: var(--text-base);
    line-height: 1.5;
    color: var(--color-ink-muted);
  }

  /* One card, centred, capped at the width it has in the grid so it never
     stretches into a shape the catalogue never shows. */
  .not-found__card {
    inline-size: min(100%, 22rem);
    margin-block-start: 1rem;
    text-align: start;
  }

  .not-found__routes {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-block-start: 1.5rem;
  }

  /* Same affordance as every other action in the system — 44px, the control
     radius, brand ink — declared here rather than as a shared `.btn` because
     nothing else on the site needs it. See `.sign-card__cta`. */
  .not-found__route {
    display: inline-flex;
    min-block-size: var(--spacing-touch);
    align-items: center;
    justify-content: center;
    padding-inline: 1.25rem;
    border-radius: var(--radius-control);
    font-weight: var(--font-weight-bold);
    color: var(--color-brand-ink);
    background-color: var(--color-brand-soft);
    transition: background-color var(--duration-fast) var(--ease-out);
  }

  /* The other language is offered, not pushed: outlined so the two routes are
     not equally loud on a page that already failed the visitor once. */
  .not-found__route--quiet {
    background-color: transparent;
    border: 1px solid var(--color-border-strong);
  }

  @media (hover: hover) {
    .not-found__route:hover {
      background-color: color-mix(in oklab, var(--color-brand) 18%, var(--color-brand-soft));
    }
  }

  /* The separator carries its own spaces inside the expression: a bare " · "
     in the markup gets collapsed by the template, which leaves a screen reader
     saying "catàleg·Català" as one word. */
  .not-found__locale {
    font-weight: 400;
    opacity: 0.85;
  }

  @media (width >= 40rem) {
    .not-found {
      padding-block: 3rem 4rem;
    }

    .not-found__title {
      font-size: var(--text-display);
    }

    .not-found__lead {
      font-size: var(--text-lg);
    }
  }
</style>
