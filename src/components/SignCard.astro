---
import { createTranslator } from '../lib/i18n.ts';
import { localeHref, type RoutedLocale } from '../lib/routing.ts';
import { signPath } from '../lib/signs.ts';
import { LANGUAGE_TO_SIGN_LANGUAGE, type Category, type SignEntry } from '../lib/types.ts';

interface Props {
  sign: SignEntry;
  category: Category;
  /**
   * Narrower than `Language` on purpose: a card links to the sign's own page,
   * and only the routed locales have one. An unrouted language would have to
   * build a URL that is not published.
   */
  language: RoutedLocale;
  /**
   * Whether the category chip says anything this card is not already under.
   *
   * The grid is grouped by section heading, and 217 of the 229 cards sat under
   * a heading whose text the chip then repeated word for word. The caller owns
   * this because the caller is what decides the sections (see
   * `CatalogueView.astro`); a card cannot know what is written above it.
   */
  showCategory: boolean;
}

const { sign, category, language, showCategory } = Astro.props;
const t = createTranslator(language);

const label = sign.labels[language];

/**
 * The default face of the card is always the static poster, never the video.
 *
 * Only the page's own sign language is rendered. The interface language is
 * fixed at build time and lives in the URL (`/` → LSC, `/es/` → LSE), so the
 * other language's block could never be reached anyway — shipping it and
 * hiding it with CSS cost 23% of the page for markup no visitor can see, and
 * put the wrong gesture one style override away from being shown. Leaving it
 * out is what makes the ban structural rather than a convention: LSC and LSE
 * are different languages with different gestures, and a card must never show
 * one under the other's label.
 */
const signLanguage = LANGUAGE_TO_SIGN_LANGUAGE[language];
const video = sign.videos.find((item) => item.signLanguage === signLanguage);
const isLsc = signLanguage === 'lsc';
const fullName = isLsc ? t('signLanguage.lscFull') : t('signLanguage.lseFull');
const shortName = isLsc ? t('signLanguage.lsc') : t('signLanguage.lse');

/**
 * The word is the link to its own page.
 *
 * Only the title, not the whole card: the card already carries three controls of
 * its own, and a card-wide link would swallow the taps meant for them and make
 * every toggle a nested interactive element. A heading that is a link is also
 * what gives a screen reader a route out of the heading list.
 */
const href = localeHref(signPath(sign.id), language);
---

<article
  class="sign-card"
  data-sign-id={sign.id}
  data-progress-for={sign.id}
  data-category={sign.category}
  data-first-sign={sign.isFirstSign ? 'true' : 'false'}
  data-label-ca={sign.labels.ca}
  data-label-es={sign.labels.es}
  data-label-en={sign.labels.en}
>
  <div class="sign-card__lang contents" data-sl={signLanguage}>
    <div class="sign-card__media">
      {
        video?.posterUrl ? (
          <img
            src={video.posterUrl}
            alt={`${label} — ${fullName}`}
            width="480"
            height="360"
            loading="lazy"
            decoding="async"
          />
        ) : (
          <div class="sign-card__placeholder">
            <svg class="icon-lg" aria-hidden="true" focusable="false">
              <use href={`#i-${category.icon}`} />
            </svg>
            <span class="sr-only">{t('card.posterPending')}</span>
          </div>
        )
      }
    </div>

    {
      /*
      Second in source because on a wide card they sit on the image, above the
      word — so this is the order the eye reads them in too. They are a sibling
      of the media rather than a child of it: the compact row lays the card out
      with grid areas and needs them as a direct child, and overlaying does not
      need nesting, only `position: absolute` against the card.
    */
    }
    <div class="sign-card__toggles">
      <button
        type="button"
        class="sign-card__toggle"
        data-action="favorite"
        data-sign-id={sign.id}
        aria-pressed="false"
        aria-label={t('card.addFavorite')}
        data-label-on={t('card.removeFavorite')}
        data-label-off={t('card.addFavorite')}
      >
        <svg class="icon" aria-hidden="true" focusable="false">
          <use href="#i-star"></use>
        </svg>
      </button>

      <button
        type="button"
        class="sign-card__toggle"
        data-action="learned"
        data-sign-id={sign.id}
        aria-pressed="false"
        aria-label={t('card.markLearned')}
        data-label-on={t('card.unmarkLearned')}
        data-label-off={t('card.markLearned')}
      >
        <svg class="icon" aria-hidden="true" focusable="false">
          <use href="#i-check"></use>
        </svg>
      </button>
    </div>

    <div class="sign-card__header">
      {
        /*
        The word and its category read as one block, and the wrapper is what
        lets the compact row put them side by side without either arrangement
        fighting the toggles for the same line.
      */
      }
      <div class="sign-card__label">
        {
          /* h3: the grid is grouped under section headings, and a card belongs to
            one of them rather than sitting beside it. */
        }
        <h3 class="sign-card__title">
          {
            /*
            The visually hidden half is the same pattern the CTAs use, and it is
            here for two reasons that happen to agree. A screen reader listing
            the links of this page would otherwise hear 194 bare words with no
            hint of where any of them goes; and Lighthouse rejects a link whose
            entire text sits in its blocklist of generic words, which on a page
            made of vocabulary is a matter of time — "ir" tripped it and scored
            the Spanish catalogue 0.92 on SEO. It says "fitxa" rather than
            "veure el signe" on purpose: the play button on the same card is
            already called that, and two links a card apart with the same name
            and different destinations is the confusion this is meant to avoid.
          */
          }
          <a class="sign-card__link" href={href}>
            {label}<span class="sr-only">: {t('card.openEntry')}</span>
          </a>
        </h3>
        {
          showCategory && (
            <span class="sign-card__chip" data-category={sign.category}>
              <svg class="icon-sm" aria-hidden="true" focusable="false">
                <use href={`#i-${category.icon}`} />
              </svg>
              {category.labels[language]}
            </span>
          )
        }
      </div>
    </div>

    <div class="sign-card__actions">
      {
        video === undefined ? (
          /* A statement of fact, not a control. It used to wear the CTA's
             silhouette — 44px tall, rounded, dashed outline — which reads as a
             disabled button, so it promised an action that does not exist and
             by §2.1 never will. */
          <p class="sign-card__novideo">
            <svg class="icon-sm" aria-hidden="true" focusable="false">
              <use href="#i-video-off" />
            </svg>
            {t('card.noVideo', { signLanguage: shortName })}
          </p>
        ) : video.delivery === 'youtube-embed' ? (
          <button
            type="button"
            class="sign-card__cta"
            data-action="play"
            data-sign-id={sign.id}
            data-sign-language={signLanguage}
            data-label={label}
            data-video-url={video.videoUrl}
            data-poster-url={video.posterUrl}
            data-source={video.source}
            data-source-url={video.sourceUrl}
            data-license={video.license}
          >
            <svg class="icon-sm" aria-hidden="true" focusable="false">
              <use href="#i-play" />
            </svg>
            {t('card.watchSign')}
            <span class="sr-only">: {label}</span>
          </button>
        ) : (
          /* This source only allows linking to its original entry, never
             embedding or re-hosting. */
          <a
            class="sign-card__cta sign-card__cta--external"
            href={video.videoUrl}
            target="_blank"
            rel="noreferrer noopener"
          >
            {t('card.watchAtSource', { source: video.source })}
            <span class="sr-only">: {label}</span>
            <svg class="icon-sm" aria-hidden="true" focusable="false">
              <use href="#i-external" />
            </svg>
          </a>
        )
      }
    </div>
  </div>
</article>
