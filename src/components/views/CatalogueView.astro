---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SignCard from '../SignCard.astro';
import CatalogueToolbar from '../../islands/CatalogueToolbar.tsx';
import SignVideoDialog from '../../islands/SignVideoDialog.tsx';
import { createTranslator } from '../../lib/i18n.ts';
import { type Category, type SignEntry } from '../../lib/types.ts';
import type { RoutedLocale } from '../../lib/routing.ts';

interface Props {
  language: RoutedLocale;
}

const { language } = Astro.props;
const t = createTranslator(language);

const categoryEntries = await getCollection('categories');
const categories: Category[] = categoryEntries
  .map((entry) => entry.data as Category)
  .sort((a, b) => a.order - b.order);

const categoryById = new Map(categories.map((category) => [category.id, category]));
const categoryOrder = new Map(categories.map((category) => [category.id, category.order]));

const signEntries = await getCollection('signs');
const signs: SignEntry[] = signEntries
  .map((entry) => ({ id: entry.id, ...entry.data }) as SignEntry)
  .sort((a, b) => {
    // The curated path leads, then thematic categories, then alphabetically.
    if (a.isFirstSign !== b.isFirstSign) return a.isFirstSign ? -1 : 1;
    if (a.isFirstSign && b.isFirstSign) {
      return (a.firstSignOrder ?? 0) - (b.firstSignOrder ?? 0);
    }
    const categoryDelta =
      (categoryOrder.get(a.category) ?? 0) - (categoryOrder.get(b.category) ?? 0);
    if (categoryDelta !== 0) return categoryDelta;
    return a.labels[language].localeCompare(b.labels[language], language);
  });

const toolbarCategories = categories.map((category) => ({
  id: category.id,
  label: category.labels[language],
}));

/**
 * The grid, with a heading before each run of signs.
 *
 * The order above already groups the catalogue — the curated route, then one
 * category after another — but nothing said so on screen: you scrolled past
 * thirty-two food words with no indication of where they ended. These make the
 * existing structure visible instead of inventing a new one, which is why the
 * runs are detected from the sorted list rather than declared a second time.
 *
 * Headings stay in place when a filter is on, and the controller hides the
 * ones left empty. That keeps search results grouped by category rather than
 * arriving as one flat run, and keeps the heading levels unbroken — a section
 * that vanished would leave the card headings under nothing.
 */
type GridItem =
  | { kind: 'section'; id: string; label: string }
  | { kind: 'sign'; sign: SignEntry; category: Category };

const FIRST_SIGNS_SECTION = 'first-signs';

const gridItems: GridItem[] = [];
let openSection: string | null = null;

for (const sign of signs) {
  const category = categoryById.get(sign.category);
  if (!category) continue;

  const section = sign.isFirstSign ? FIRST_SIGNS_SECTION : sign.category;
  if (section !== openSection) {
    openSection = section;
    gridItems.push({
      kind: 'section',
      id: section,
      label: sign.isFirstSign ? t('filter.firstSigns') : category.labels[language],
    });
  }

  gridItems.push({ kind: 'sign', sign, category });
}
---

<BaseLayout language={language} path="/">
  <CatalogueToolbar
    slot="toolbar"
    categories={toolbarCategories}
    language={language}
    initialCount={signs.length}
    client:load
  />

  <section class="hero">
    <h1 class="hero__title max-w-5xl">
      {t('hero.title')}{' '}
      <span class="hero__accent">{t('hero.titleAccent')}</span>
    </h1>
    <p class="hero__lead">{t('hero.lead')}</p>
  </section>

  {
    /*
    One column on phones on purpose. Two columns squeezed each card to 166px,
    which is what forced the word — the thing being looked up — into an
    ellipsis. Below `sm` the card switches to its compact row layout (see
    `.sign-card` in global.css), so a single column is also shorter per entry
    than the two-column card was: more of the catalogue fits on screen, not
    less.
  */
  }
  {
    /*
    Bypass block (WCAG 2.4.1). The grid holds 638 of the page's 654 focus
    stops, so everything after it — the footer, and the only route to the
    other pages on a phone — sat 650 Tab presses away. This is the standard
    escape hatch: invisible until focused, and it lands on the footer nav
    itself so the next Tab is already the first link there.
  */
  }
  <a class="bypass-link" href="#footer-nav">{t('nav.skipCatalogue')}</a>

  <div
    id="sign-grid"
    data-lang={language}
    class="grid grid-cols-1 gap-3 sm:grid-cols-2 sm:gap-4 md:grid-cols-3 xl:grid-cols-4"
  >
    {
      /*
      `showCategory` is exactly "is this card under the first-signs heading":
      every other card sits under its own category, where the chip repeated the
      heading word for word — 217 of the 229. The condition is written against
      the same `isFirstSign` that decided the section above, so the chip and the
      heading cannot drift apart.
    */
    }
    {
      gridItems.map((item) =>
        item.kind === 'section' ? (
          <h2 class="grid-section" data-section={item.id}>
            {item.label}
          </h2>
        ) : (
          <SignCard
            sign={item.sign}
            category={item.category}
            language={language}
            showCategory={item.sign.isFirstSign}
          />
        ),
      )
    }
  </div>

  <div id="no-results" class="empty-state" role="status"></div>

  <SignVideoDialog language={language} client:idle />
</BaseLayout>

<script>
  import { mountCatalogue } from '../../lib/catalogue-grid.ts';
  import { $query, $statusFilter, $visibleCount, rememberLanguage } from '../../lib/stores.ts';
  import { createTranslator, type MessageKey } from '../../lib/i18n.ts';
  import { isRoutedLocale } from '../../lib/routing.ts';
  import { isSearchable } from '../../lib/search.ts';

  const grid = document.getElementById('sign-grid');
  const emptyState = document.getElementById('no-results');

  if (grid) {
    mountCatalogue(grid);

    // Read the page language from the DOM so this script matches whichever
    // localised page it runs on.
    const lang = grid.dataset.lang ?? 'ca';
    if (isRoutedLocale(lang)) void rememberLanguage(lang);

    const t = createTranslator(isRoutedLocale(lang) ? lang : 'ca');

    // The empty state explains *why* the grid is empty: an empty "favourites"
    // filter reads differently from a search that found nothing. Interpolated
    // text is set via textContent, never innerHTML, so a query can't inject markup.
    function renderEmptyState() {
      if (!emptyState) return;

      // Emptying the element is what hides it (`.empty-state:empty`). The live
      // region itself is never removed or hidden, so it is already registered
      // with assistive technology when its content appears — a region that is
      // revealed and filled in the same frame is announced unreliably.
      if ($visibleCount.get() !== 0) {
        emptyState.replaceChildren();
        return;
      }

      const query = $query.get().trim();
      const status = $statusFilter.get();

      let emoji = '🤷';
      let titleKey: MessageKey = 'empty.generic.title';
      let hintKey: MessageKey = 'empty.generic.hint';

      // Same gate as the filter (`isSearchable`, not `!== ''`), or a query too
      // short to search would blame the empty grid on a search that never ran.
      if (isSearchable(query)) {
        emoji = '🔍';
        titleKey = 'empty.search.title';
        hintKey = 'empty.search.hint';
      } else if (status === 'favorites') {
        emoji = '💛';
        titleKey = 'empty.favorites.title';
        hintKey = 'empty.favorites.hint';
      } else if (status === 'learned') {
        emoji = '🌱';
        titleKey = 'empty.learned.title';
        hintKey = 'empty.learned.hint';
      } else if (status === 'pending') {
        emoji = '🎉';
        titleKey = 'empty.pending.title';
        hintKey = 'empty.pending.hint';
      }

      const emojiEl = document.createElement('span');
      emojiEl.className = 'empty-state__emoji';
      emojiEl.setAttribute('aria-hidden', 'true');
      emojiEl.textContent = emoji;

      const titleEl = document.createElement('p');
      titleEl.className = 'empty-state__title';
      titleEl.textContent = t(titleKey, { query });

      const hintEl = document.createElement('p');
      hintEl.className = 'empty-state__hint';
      hintEl.textContent = t(hintKey);

      emptyState.replaceChildren(emojiEl, titleEl, hintEl);
    }

    // Switching between two empty filters keeps the count at 0, so the count
    // store alone would not re-fire: also react to the filters that set the reason.
    $visibleCount.subscribe(renderEmptyState);
    $query.subscribe(renderEmptyState);
    $statusFilter.subscribe(renderEmptyState);
  }
</script>
