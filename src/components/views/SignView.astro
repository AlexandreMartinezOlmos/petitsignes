---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SignVideoDialog from '../../islands/SignVideoDialog.tsx';
import { categoryInSentence, createTranslator } from '../../lib/i18n.ts';
import { localeHref, type RoutedLocale } from '../../lib/routing.ts';
import { categoryPath } from '../../lib/categories.ts';
import { relatedSigns, signPath } from '../../lib/signs.ts';
import { newIssueUrl } from '../../lib/site.ts';
import { LANGUAGE_TO_SIGN_LANGUAGE, type Category, type SignEntry } from '../../lib/types.ts';

interface Props {
  language: RoutedLocale;
  sign: SignEntry;
}

/**
 * One sign, at its own address.
 *
 * The catalogue publishes 194 concepts on one page, which is one thing as far as
 * a search engine is concerned — while the question a parent actually types is
 * "how do you sign milk in LSC". This page is the answer to exactly that
 * question, and it is also the link you can send someone.
 *
 * Like every other page it ships only its own sign language (§4.4). The two
 * locales are two builds of the same file, so an LSE gesture can no more reach
 * the Catalan page here than it can in the grid.
 *
 * There are no posters and there cannot be (§2.1), so the media block is the
 * same neutral category marker the card uses. Nothing on this page describes how
 * the gesture is made: it names the word, credits the source and gets out of the
 * way of the video.
 */
const { language, sign } = Astro.props;
const t = createTranslator(language);

const signLanguage = LANGUAGE_TO_SIGN_LANGUAGE[language];
const video = sign.videos.find((item) => item.signLanguage === signLanguage);
const isLsc = signLanguage === 'lsc';
const fullName = isLsc ? t('signLanguage.lscFull') : t('signLanguage.lseFull');
const shortName = isLsc ? t('signLanguage.lsc') : t('signLanguage.lse');

const label = sign.labels[language];

const categoryEntries = await getCollection('categories');
const categoryEntry = categoryEntries.find((item) => item.data.id === sign.category);
if (!categoryEntry) {
  throw new Error(`Sign "${sign.id}" is in category "${sign.category}", which does not exist`);
}
const category = categoryEntry.data as Category;

const signEntries = await getCollection('signs');
const allSigns: SignEntry[] = signEntries.map((entry) => ({ id: entry.id, ...entry.data }));
const related = relatedSigns(sign, allSigns, language);

// Counted, not written down: the link says how many are on the category page,
// and a number that drifts from the page it points at is worse than no number.
const categoryCount = allSigns.filter((other) => other.category === sign.category).length;

// The category as it reads inside a sentence — "els 27 signes d'animals", not
// "de Animals". The chip and the breadcrumb keep the label as written; only
// prose gets this. See `categoryInSentence`.
const ofCategory = categoryInSentence(language, category.labels[language]);

const catalogueHref = localeHref('/', language);

/**
 * The description is the sentence a search result shows, so it says what the
 * page can actually deliver. When a sign language has no video for this concept
 * the page still exists and is still worth reaching — but promising a video it
 * does not have would be the same false claim §2.1 forbids on the card.
 */
const description = video
  ? t('sign.meta', { label, signLanguage: fullName })
  : t('sign.metaNoVideo', { label, signLanguage: fullName });

/**
 * The date the source last updated this entry. Showing it is not a nicety: the
 * Vocabulari is reused under Llei 19/2014 art. 17.1, which requires citing both
 * the source and the date of the version being reused.
 */
const updatedAt = video
  ? new Intl.DateTimeFormat(language, { dateStyle: 'long' }).format(new Date(video.updatedAt))
  : null;

/**
 * The route for someone who can tell us we got a sign wrong.
 *
 * §2.1 is the promise the project rests on, and the only people able to catch a
 * breach of it are the ones who know LSC or LSE. The project page invited them
 * to open an issue; this page — the one screen where the mistake is visible —
 * had no route at all.
 *
 * Prefilled from build-time data only: the concept's id, its label, the sign
 * language and this page's address. Nothing a visitor typed goes near it, so it
 * raises none of the questions §2.2 answers.
 *
 * The page URL is absolute and built from `Astro.site`, so a report opened from
 * a branch preview says so instead of pointing the maintainer at production.
 */
const pageUrl = new URL(localeHref(signPath(sign.id), language), Astro.site).href;
const reportUrl = newIssueUrl(
  t('sign.issueTitle', { label, signLanguage: shortName }),
  t('sign.issueBody', { label, signId: sign.id, signLanguage: shortName, pageUrl }),
);
---

<BaseLayout language={language} path={signPath(sign.id)} title={label} description={description}>
  <div class="sign-page">
    {
      /*
      Three steps now, not two. The category in the middle is the route that
      makes its page reachable by a person rather than only by a crawler, and it
      is also the honest shape of where this page sits: a sign belongs to a
      category, which belongs to the catalogue.
    */
    }
    <nav class="breadcrumb" aria-label={t('nav.breadcrumb')}>
      <a class="breadcrumb__link" href={catalogueHref}>{t('nav.catalogue')}</a>
      <span class="breadcrumb__sep" aria-hidden="true">/</span>
      <a class="breadcrumb__link" href={localeHref(categoryPath(category.id), language)}>
        {category.labels[language]}
      </a>
      <span class="breadcrumb__sep" aria-hidden="true">/</span>
      <span class="breadcrumb__current" aria-current="page">{label}</span>
    </nav>

    {
      /*
      `data-progress-for` is what wires the two toggles below to the same
      storage the catalogue writes: favouriting a sign here and going back to
      the grid has to show it favourited there.
    */
    }
    <article class="sign-detail" data-progress-for={sign.id} data-category={sign.category}>
      {
        /*
        Reuses the card's own placeholder — same gradient, same halo, same
        icon colour — rather than a lookalike built from scratch. `data-category`
        moved up to the article so this and the chip below read the same custom
        properties; a panel painted from a different rule than the chip beside
        it read as a different component wearing the category's colours by
        coincidence. There is no poster and there cannot be one (§2.1), so this
        stays the concept marker; the day a source grants a still image the
        card's own `posterUrl` branch is what gets mirrored here, not this
        placeholder.
      */
      }
      <div class="sign-detail__media">
        <div class="sign-card__placeholder">
          <svg class="icon-lg" aria-hidden="true" focusable="false">
            <use href={`#i-${category.icon}`}></use>
          </svg>
          <span class="sr-only">{t('card.posterPending')}</span>
        </div>
      </div>

      <div class="sign-detail__body">
        <p class="sign-detail__category">
          <span class="sign-card__chip" data-category={sign.category}>
            <svg class="icon-sm" aria-hidden="true" focusable="false">
              <use href={`#i-${category.icon}`}></use>
            </svg>
            {category.labels[language]}
          </span>
        </p>

        <h1 class="sign-detail__title">{label}</h1>
        <p class="sign-detail__subtitle">{t('sign.subtitle', { signLanguage: fullName })}</p>
      </div>

      {
        /*
        A third grid area rather than nested inside `body`: from 320px up the
        CTA needs the row's full width, not the narrow column beside a square
        media panel — the same reason the card keeps its actions out of the
        label wrapper in its own compact row. See the `.sign-detail` rule.
      */
      }
      <div class="sign-detail__actions">
        {
          video === undefined ? (
            /* A statement of fact, not a control — the same wording and the
               same reasoning as on the card: this sign language has no entry
               we may show, and by §2.1 we will not invent one. */
            <p class="sign-card__novideo">
              <svg class="icon-sm" aria-hidden="true" focusable="false">
                <use href="#i-video-off" />
              </svg>
              {t('card.noVideo', { signLanguage: shortName })}
            </p>
          ) : video.delivery === 'youtube-embed' ? (
            <button
              type="button"
              class="sign-card__cta sign-detail__cta"
              data-action="play"
              data-sign-id={sign.id}
              data-sign-language={signLanguage}
              data-label={label}
              data-video-url={video.videoUrl}
              data-poster-url={video.posterUrl}
              data-source={video.source}
              data-source-url={video.sourceUrl}
              data-license={video.license}
            >
              <svg class="icon-sm" aria-hidden="true" focusable="false">
                <use href="#i-play" />
              </svg>
              {t('card.watchSign')}
              <span class="sr-only">: {label}</span>
            </button>
          ) : (
            <a
              class="sign-card__cta sign-card__cta--external sign-detail__cta"
              href={video.videoUrl}
              target="_blank"
              rel="noreferrer noopener"
            >
              {t('card.watchAtSource', { source: video.source })}
              <span class="sr-only">: {label}</span>
              <svg class="icon-sm" aria-hidden="true" focusable="false">
                <use href="#i-external" />
              </svg>
            </a>
          )
        }

        <div class="sign-detail__toggles">
          <button
            type="button"
            class="sign-card__toggle"
            data-action="favorite"
            data-sign-id={sign.id}
            aria-pressed="false"
            aria-label={t('card.addFavorite')}
            data-label-on={t('card.removeFavorite')}
            data-label-off={t('card.addFavorite')}
          >
            <svg class="icon" aria-hidden="true" focusable="false">
              <use href="#i-star"></use>
            </svg>
          </button>

          <button
            type="button"
            class="sign-card__toggle"
            data-action="learned"
            data-sign-id={sign.id}
            aria-pressed="false"
            aria-label={t('card.markLearned')}
            data-label-on={t('card.unmarkLearned')}
            data-label-off={t('card.markLearned')}
          >
            <svg class="icon" aria-hidden="true" focusable="false">
              <use href="#i-check"></use>
            </svg>
          </button>
        </div>
      </div>
    </article>

    {
      /*
      The videos are not ours. Every one of them travels with its source, the
      licence it is used under and the date of that version — which is what the
      Vocabulari's terms require, not a courtesy. On the card this only fits
      inside the player; here there is room to print it in full.
    */
    }
    {
      video && (
        <section class="sign-source" aria-labelledby="sign-source-title">
          <h2 class="sign-source__title" id="sign-source-title">
            {t('sign.sourceTitle')}
          </h2>
          <dl class="sign-source__list">
            <dt>{t('sign.sourceName')}</dt>
            <dd>{video.source}</dd>

            <dt>{t('sign.sourceEntry')}</dt>
            <dd>
              <a href={video.sourceUrl} target="_blank" rel="noreferrer noopener">
                {video.sourceUrl}
              </a>
            </dd>

            {video.variant && (
              <Fragment>
                <dt>{t('sign.variant')}</dt>
                <dd>{video.variant}</dd>
              </Fragment>
            )}

            <dt>{t('sign.sourceUpdated')}</dt>
            <dd>
              <time datetime={video.updatedAt}>{updatedAt}</time>
            </dd>
          </dl>
          <p class="sign-source__license">{video.license}</p>
        </section>
      )
    }

    {
      /*
      Right after the attribution, because that is the moment someone who knows
      the language has just checked where the video came from. Outside the
      `video &&` block above on purpose: a label can be wrong in a concept that
      has no video at all, and those are the entries least likely to be checked
      by anyone else.

      Deliberately quiet — a line of text, not a call to action. It competes with
      nothing on a page whose job is to show one sign, and someone who has
      spotted a mistake is already looking for a way to say so.
    */
    }
    <p class="sign-report">
      <a class="sign-report__link" href={reportUrl} target="_blank" rel="noreferrer noopener">
        {t('sign.report')}
        <svg class="icon-sm" aria-hidden="true" focusable="false">
          <use href="#i-external"></use>
        </svg>
      </a>
      <span class="sign-report__hint">{t('sign.reportHint')}</span>
    </p>

    {
      /*
      The way onward. A page with one word and one video is a dead end, and 194
      of them reachable only from the index is a catalogue a crawler walks once
      and never again. These are the same category the visitor is already in,
      which is the only relationship the data actually states.
    */
    }
    {
      related.length > 0 && (
        <section class="sign-related" aria-labelledby="sign-related-title">
          <h2 class="sign-related__title" id="sign-related-title">
            {t('sign.relatedTitle', { ofCategory })}
          </h2>
          <ul class="sign-related__list">
            {related.map((other) => (
              <li>
                {/* Same reasoning as the card's title link: a list of bare
                    words tells a screen reader nothing about where they go. */}
                <a class="sign-related__link" href={localeHref(signPath(other.id), language)}>
                  {other.labels[language]}
                  <span class="sr-only">: {t('card.openEntry')}</span>
                </a>
              </li>
            ))}
          </ul>
          {/* Six of the category is a sample; this is where the rest of them
              are. It used to point at the whole catalogue, which was the only
              destination that existed — the breadcrumb above still offers it. */}
          <p>
            <a class="sign-related__all" href={localeHref(categoryPath(category.id), language)}>
              {t('sign.relatedAll', {
                count: categoryCount,
                ofCategory,
              })}
            </a>
          </p>
        </section>
      )
    }
  </div>

  <SignVideoDialog language={language} client:idle />
</BaseLayout>

<script>
  import { mountSignCards } from '../../lib/catalogue-grid.ts';

  /**
   * The same wiring a card gets in the grid: the two toggles persist to storage
   * and the CTA opens the player. Nothing here knows it is not a card, because
   * `mountSignCards` looks for `data-progress-for` rather than for a class.
   */
  const root = document.querySelector<HTMLElement>('.sign-page');
  if (root) mountSignCards(root);
</script>

<style>
  /* Only this page uses these, so they stay here rather than in global.css —
     the design system is for what repeats. The chip, the CTA and the
     missing-video note are the exception: they are the catalogue's own
     components and are reused as they are, so that a sign looks the same
     wherever it is met. */
  .sign-page {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    max-inline-size: 46rem;
  }

  /* Paired with the word from 320px up — the same shape the card itself takes
     below `sm` (see the compact row in global.css) — rather than a full-width
     band above the text. Measured at 343×128 on a 375px screen, the band was
     2.7:1: a ratio nothing square reads well in, and the one place this panel
     did not match the card it is a smaller copy of. `actions` is a third grid
     area, not nested in `body`, because the CTA needs the row's full width;
     media spans both rows only once there is room to stand the panel upright
     again (see the `40rem` query below). */
  .sign-detail {
    display: grid;
    grid-template-columns: 6rem 1fr;
    grid-template-areas: 'media body' 'actions actions';
    column-gap: 1rem;
    row-gap: 1.25rem;
    align-items: center;
  }

  /* Reuses `.sign-card__placeholder` for the gradient, halo and icon — see the
     comment on the element itself. This box only sets the shape: a square
     stands a pictogram upright the way the band above it could not, and
     `overflow: hidden` is what lets the halo (sized for the card, not this
     panel) sit behind the icon instead of spilling past the rounded corners. */
  .sign-detail__media {
    grid-area: media;
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--radius-card);
  }

  .sign-detail__body {
    grid-area: body;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .sign-detail__category {
    display: flex;
  }

  /* The word, as loud as the site's own title elsewhere: on this page it is the
     content, not a label for it. */
  .sign-detail__title {
    font-size: var(--text-display);
    font-weight: var(--font-weight-heavy);
    line-height: var(--text-display--line-height);
    letter-spacing: var(--text-display--letter-spacing);
    color: var(--color-ink);
    overflow-wrap: break-word;
    hyphens: auto;
  }

  .sign-detail__subtitle {
    font-size: var(--text-base);
    color: var(--color-ink-muted);
  }

  .sign-detail__actions {
    grid-area: actions;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .sign-detail__cta {
    /* Wider than in the grid: here it is the page's one primary action rather
       than one card's among 194. */
    padding-inline: 1.5rem;
  }

  .sign-detail__toggles {
    display: flex;
    gap: 0.5rem;
  }

  .sign-source__title,
  .sign-related__title {
    font-size: var(--text-lg);
    font-weight: var(--font-weight-display);
    color: var(--color-ink);
    margin-block-end: 0.75rem;
  }

  /* A definition list because that is what this is: four labelled facts about
     one thing. The grid keeps the labels in a column of their own without the
     markup pretending to be a table. */
  .sign-source__list {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.375rem 1rem;
    font-size: var(--text-sm);
  }

  .sign-source__list dt {
    font-weight: var(--font-weight-bold);
    color: var(--color-ink);
  }

  .sign-source__list dd {
    color: var(--color-ink-muted);
    /* A source URL is long and has no spaces the browser may break at, so
       without this it decides the width of the whole page at 320px. */
    overflow-wrap: anywhere;
  }

  /* The one link in this block sat in muted grey with no underline, which made
     it indistinguishable from the three facts around it — colour alone would not
     have been enough either (WCAG 1.4.1). */
  .sign-source__list a {
    color: var(--color-brand-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .sign-source__license {
    margin-block-start: 0.75rem;
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }

  .sign-related__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block-end: 1rem;
  }

  .sign-related__link {
    display: inline-flex;
    min-block-size: var(--spacing-touch);
    align-items: center;
    padding-inline: 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-chip);
    color: var(--color-ink);
    background-color: var(--color-surface);
  }

  @media (hover: hover) {
    .sign-related__link:hover {
      border-color: var(--color-brand);
      background-color: var(--color-brand-soft);
    }
  }

  .sign-related__all {
    display: inline-flex;
    min-block-size: var(--spacing-touch);
    align-items: center;
    color: var(--color-brand-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Two lines that wrap independently: the link keeps its own 44px target and
     the explanation sits under it, rather than the two sharing a line that
     leaves a tappable area running the width of a paragraph. */
  .sign-report {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    margin-block-start: 2rem;
  }

  .sign-report__link {
    display: inline-flex;
    min-block-size: var(--spacing-touch);
    align-items: center;
    gap: 0.4rem;
    color: var(--color-brand-ink);
    font-weight: var(--font-weight-semibold);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* The honest half. This link goes somewhere that asks for an account, and a
     parent who taps it and lands on a login wall has been sent to a dead end —
     so it says so before the tap, not after. */
  .sign-report__hint {
    max-inline-size: 52ch;
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--color-ink-muted);
  }

  /* Media stands up again once there is room: 4:3 rather than square, and
     spanning both rows so it sits beside the word and the actions together,
     the way it did before H1 — that part was never the problem, only the
     paired media panel below `sm` was missing it. `height >= 34rem` keeps a
     landscape phone (short but wide) on the paired-row layout above, for the
     same reason the card's compact row checks both axes: a stood-up panel at
     390px of height leaves no room for the word under it. */
  @media (width >= 40rem) and (height >= 34rem) {
    .sign-detail {
      grid-template-columns: 16rem 1fr;
      grid-template-areas: 'media body' 'media actions';
      column-gap: 2rem;
      row-gap: 0.75rem;
    }

    .sign-detail__media {
      aspect-ratio: 4 / 3;
    }
  }
</style>
