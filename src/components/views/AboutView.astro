---
import { getCollection } from 'astro:content';
import PageShell, { type PageSection } from '../PageShell.astro';
import ProgressData from '../../islands/ProgressData.tsx';
import { createTranslator } from '../../lib/i18n.ts';
import { localeHref, type RoutedLocale } from '../../lib/routing.ts';
import { REPO_URL } from '../../lib/site.ts';

interface Props {
  language: RoutedLocale;
}

const { language } = Astro.props;
const t = createTranslator(language);
const creditsHref = localeHref('/credits/', language);

// The catalogue is the authority on which ids are real, and this is the only
// page that needs to know: an import drops the rest, and the summary counts what
// is left. Sorted so the emitted markup does not reshuffle between builds.
const signIds = (await getCollection('signs')).map((entry) => entry.id).sort();

// User-facing prose (not developer docs), so it is translated by hand rather
// than machine-fed. Mirrors the purpose stated in the repository README.
const copy = {
  ca: {
    title: 'El projecte',
    intro:
      'Abans de dir la primera paraula, un nadó ja es pot comunicar amb les mans: demanar «llet», dir «s’ha acabat» o «una altra vegada» amb un gest senzill redueix la frustració molt abans de parlar. Petits Signes recull signes reals de la llengua de signes catalana (LSC) i espanyola (LSE) perquè les famílies oients els puguin fer servir amb el seu nadó.',
    whoTitle: 'Per a qui és',
    whoBody:
      'Per a mares, pares i cuidadors que volen aprendre un grapat de signes útils del dia a dia —menjar, dormir, llet, gràcies— sense haver d’estudiar una llengua sencera de cop. I per a la comunitat educativa (escoles bressol, llevadores, logopedes) que el vulgui fer servir com a recurs lliure o recomanar-lo a les famílies.',
    principlesTitle: 'En què creiem',
    principles: [
      'Cap signe inventat. Cada signe ve d’una font oficial verificable; si no en tenim, la fitxa es queda sense vídeo en lloc d’ensenyar-ne un de dubtós.',
      'Mai substituïm el signe d’una llengua pel de l’altra: la LSC i la LSE són llengües diferents, amb gestos diferents.',
      'Gratuït, sense comptes, sense publicitat i sense galetes. El teu progrés es desa només al teu dispositiu.',
      'És una porta d’entrada a llengües reals, no un substitut de l’aprenentatge formal ni de la comunitat sorda.',
    ],
    sourcesTitle: 'D’on surten els signes',
    sourcesBody:
      'Els vídeos no són obra del projecte: provenen de fonts oficials —el Vocabulari bàsic de la LSC de la Generalitat, amb assessorament de la FESOCA, i el DILSE de la Fundación CNSE— i cada fitxa n’indica l’origen.',
    sourcesLink: 'Consulta les fonts i els crèdits',
    privacyTitle: 'Què mesurem (i què no)',
    privacyBody:
      'Per saber si el projecte serveix d’alguna cosa comptem visites de manera anònima i agregada amb GoatCounter: quines pàgines es visiten i quantes vegades es fa servir cada funció. Sense galetes, sense identificadors i sense seguir ningú entre visites — per això no cal cap avís de galetes. No es desa mai el que cerques ni cap dada personal, i el teu progrés no surt del teu dispositiu.',
    openTitle: 'Codi obert',
    openBody:
      'Petits Signes és programari lliure. Qualsevol pot veure com està fet, proposar millores o avisar d’un error —en un signe, una traducció o l’accessibilitat— obrint una incidència al repositori.',
    openCta: 'Veure el projecte a GitHub',
  },
  es: {
    title: 'El proyecto',
    intro:
      'Antes de decir su primera palabra, un bebé ya puede comunicarse con las manos: pedir «leche», decir «se acabó» u «otra vez» con un gesto sencillo reduce la frustración mucho antes de hablar. Petits Signes reúne signos reales de la lengua de signos catalana (LSC) y española (LSE) para que las familias oyentes puedan usarlos con su bebé.',
    whoTitle: 'Para quién es',
    whoBody:
      'Para madres, padres y cuidadores que quieren aprender un puñado de signos útiles del día a día —comer, dormir, leche, gracias— sin tener que estudiar una lengua entera de golpe. Y para la comunidad educativa (escuelas infantiles, matronas, logopedas) que quiera usarlo como recurso libre o recomendarlo a las familias.',
    principlesTitle: 'En qué creemos',
    principles: [
      'Ningún signo inventado. Cada signo procede de una fuente oficial verificable; si no la tenemos, la ficha se queda sin vídeo en lugar de enseñar uno dudoso.',
      'Nunca sustituimos el signo de una lengua por el de la otra: la LSC y la LSE son lenguas distintas, con gestos distintos.',
      'Gratis, sin cuentas, sin publicidad y sin cookies. Tu progreso se guarda solo en tu dispositivo.',
      'Es una puerta de entrada a lenguas reales, no un sustituto del aprendizaje formal ni de la comunidad sorda.',
    ],
    sourcesTitle: 'De dónde salen los signos',
    sourcesBody:
      'Los vídeos no son obra del proyecto: proceden de fuentes oficiales —el Vocabulari bàsic de la LSC de la Generalitat, con asesoramiento de FESOCA, y el DILSE de la Fundación CNSE— y cada ficha indica su origen.',
    sourcesLink: 'Consulta las fuentes y los créditos',
    privacyTitle: 'Qué medimos (y qué no)',
    privacyBody:
      'Para saber si el proyecto sirve de algo contamos visitas de forma anónima y agregada con GoatCounter: qué páginas se visitan y cuántas veces se usa cada función. Sin cookies, sin identificadores y sin seguir a nadie entre visitas — por eso no hace falta ningún aviso de cookies. Nunca se guarda lo que buscas ni ningún dato personal, y tu progreso no sale de tu dispositivo.',
    openTitle: 'Código abierto',
    openBody:
      'Petits Signes es software libre. Cualquiera puede ver cómo está hecho, proponer mejoras o avisar de un error —en un signo, una traducción o la accesibilidad— abriendo una incidencia en el repositorio.',
    openCta: 'Ver el proyecto en GitHub',
  },
} as const;

const c = copy[language];

const sections: PageSection[] = [
  { id: 'who', title: c.whoTitle },
  { id: 'principles', title: c.principlesTitle },
  { id: 'sources', title: c.sourcesTitle },
  { id: 'data', title: t('progress.title') },
  { id: 'privacy', title: c.privacyTitle },
  { id: 'open', title: c.openTitle },
];
---

<PageShell
  language={language}
  path="/el-projecte/"
  title={c.title}
  lead={c.intro}
  sections={sections}
>
  <p slot="who">{c.whoBody}</p>

  <ul class="page-list" slot="principles">
    {c.principles.map((item) => <li>{item}</li>)}
  </ul>

  <Fragment slot="sources">
    <p>{c.sourcesBody}</p>
    <p><a href={creditsHref}>{c.sourcesLink}</a></p>
  </Fragment>

  {
    /* Directly after the "no accounts, nothing leaves your device" promise
       above: this is where that promise has to become something the visitor
       can act on. `client:visible` keeps it off the catalogue's JS budget.
       Its own section now, so it appears in the contents list — with no
       accounts, this is the only way anyone keeps their progress. */
  }
  <ProgressData slot="data" language={language} signIds={signIds} client:visible />

  <p slot="privacy">{c.privacyBody}</p>

  <Fragment slot="open">
    <p>{c.openBody}</p>
    <p>
      <a href={REPO_URL} target="_blank" rel="noreferrer noopener">{c.openCta}</a>
    </p>
  </Fragment>
</PageShell>
