---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SignCard from '../SignCard.astro';
import SignVideoDialog from '../../islands/SignVideoDialog.tsx';
import { createTranslator } from '../../lib/i18n.ts';
import { localeHref, type RoutedLocale } from '../../lib/routing.ts';
import { type Category, type SignEntry } from '../../lib/types.ts';

interface Props {
  language: RoutedLocale;
}

/**
 * The page served from any address that does not exist.
 *
 * There is one per locale, at `/404.html` and `/es/404.html`. Cloudflare Pages
 * answers an unmatched request with the closest `404.html` walking up the
 * directory tree, so `/es/qualsevol-cosa` finds the Spanish one rather than
 * falling back to the root — which means the page never has to guess a language
 * from the path, and each build ships only its own sign language exactly as
 * every other page does (§4.4).
 *
 * The sign it shows is `no` — a real catalogue entry with its verified source,
 * not an illustration drawn for this page. A dead end is the one place where
 * being handed a word costs nothing.
 */
const { language } = Astro.props;
const t = createTranslator(language);

const signEntries = await getCollection('signs');
const entry = signEntries.find((item) => item.id === 'no');
if (!entry) {
  throw new Error('The 404 page expects the sign `no` to exist in the catalogue');
}
const sign: SignEntry = { id: entry.id, ...entry.data } as SignEntry;

const categoryEntries = await getCollection('categories');
const categoryEntry = categoryEntries.find((item) => item.data.id === sign.category);
if (!categoryEntry) {
  throw new Error(`The 404 page needs category "${sign.category}", which is missing`);
}
const category = categoryEntry.data as Category;
---

<BaseLayout language={language} path="/" title={t('notFound.title')} noindex>
  <section class="not-found">
    <p class="not-found__code" aria-hidden="true">404</p>
    <h1 class="not-found__title">{t('notFound.title')}</h1>
    <p class="not-found__lead">{t('notFound.lead')}</p>

    <div class="not-found__card">
      {
        /* Directly under this page's `h1`, so `h2` — the grid's `h3` would skip
          a level here. */
      }
      <SignCard
        sign={sign}
        category={category}
        language={language}
        showCategory={false}
        headingLevel={2}
      />
    </div>

    {
      /*
      One route back, in the language the visitor was already reading. The
      language switch is in the header where it always is, so offering both here
      would answer a question nobody asked and make the real way out compete
      with a second button for attention.
    */
    }
    <a class="not-found__route" href={localeHref('/', language)}>{t('notFound.back')}</a>
  </section>

  <SignVideoDialog language={language} client:idle />
</BaseLayout>

<script>
  import { mountSignCards } from '../../lib/catalogue-grid.ts';

  /**
   * The same wiring the catalogue gives its cards, minus the grid: the two
   * toggles persist to storage and the CTA opens the player. A card whose
   * controls did nothing would be a second dead end on top of the first.
   */
  const root = document.querySelector<HTMLElement>('.not-found');
  if (root) mountSignCards(root);

  // `rememberLanguage` is deliberately not called here, unlike on the catalogue.
  // A wrong address is not a language someone chose, and recording it would let
  // one bad link decide what a future "continue in your language" hint offers.
</script>

<style>
  /* Only this page uses these, so they stay here rather than in global.css —
     the design system is for what repeats. */
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding-block: 2rem 3rem;
    text-align: center;
  }

  /* Decorative, and loud enough to read as a code: it is announced to nobody
     because the heading below already says it in words. */
  .not-found__code {
    font-size: var(--text-display);
    font-weight: var(--font-weight-display);
    line-height: 1;
    color: var(--color-brand-soft);
  }

  .not-found__title {
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-display);
    line-height: var(--text-display--line-height);
    letter-spacing: var(--text-display--letter-spacing);
    color: var(--color-ink);
  }

  .not-found__lead {
    max-inline-size: 46ch;
    font-size: var(--text-base);
    line-height: 1.5;
    color: var(--color-ink-muted);
  }

  /* One card, centred, capped at the width it has in the grid so it never
     stretches into a shape the catalogue never shows. */
  .not-found__card {
    inline-size: min(100%, 22rem);
    margin-block-start: 1rem;
    text-align: start;
  }

  /* Same affordance as every other action in the system — 44px, the control
     radius, brand ink — declared here rather than as a shared `.btn` because
     nothing else on the site needs it. See `.sign-card__cta`. */
  .not-found__route {
    display: inline-flex;
    min-block-size: var(--spacing-touch);
    align-items: center;
    justify-content: center;
    margin-block-start: 1.5rem;
    padding-inline: 1.5rem;
    border-radius: var(--radius-control);
    font-weight: var(--font-weight-bold);
    color: var(--color-brand-ink);
    background-color: var(--color-brand-soft);
    transition: background-color var(--duration-fast) var(--ease-out);
  }

  @media (hover: hover) {
    .not-found__route:hover {
      background-color: color-mix(in oklab, var(--color-brand) 18%, var(--color-brand-soft));
    }
  }

  @media (width >= 40rem) {
    .not-found {
      padding-block: 3rem 4rem;
    }

    .not-found__title {
      font-size: var(--text-display);
    }

    .not-found__lead {
      font-size: var(--text-lg);
    }
  }
</style>
